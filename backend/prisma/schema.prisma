generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InviteStatus {
  OPEN      @map("open")
  SUBMITTED @map("submitted")
  REVOKED   @map("revoked")

  @@map("invite_status")
}

enum HostexDeliveryKind {
  AUTOMATED @map("automated")
  MANUAL    @map("manual")

  @@map("hostex_delivery_kind")
}

enum PricingRunMode {
  PREVIEW   @map("preview")
  MANUAL    @map("manual")
  AUTOMATIC @map("automatic")

  @@map("pricing_run_mode")
}

enum PricingRunStatus {
  RUNNING        @map("running")
  PREVIEWED      @map("previewed")
  SUBMITTED      @map("submitted")
  PARTIAL_FAILED @map("partial_failed")
  FAILED         @map("failed")

  @@map("pricing_run_status")
}

enum SubmissionStatus {
  READY_FOR_REVIEW       @map("ready_for_review")
  QUEUED                 @map("queued")
  SUBMITTING             @map("submitting")
  FAILED                 @map("failed")
  SUBMITTED_EMAIL_FAILED @map("submitted_email_failed")
  REJECTED               @map("rejected")
  SUBMITTED              @map("submitted")
  SUBMITTED_EMAIL_SENT   @map("submitted_email_sent")

  @@map("submission_status")
}

enum HostexDeliveryStatus {
  SCHEDULED         @map("scheduled")
  SENDING           @map("sending")
  SENT              @map("sent")
  CONFIRMED         @map("confirmed")
  RETRY_WAIT        @map("retry_wait")
  BLOCKED           @map("blocked")
  UNKNOWN           @map("unknown")
  CANCELLED         @map("cancelled")
  SKIPPED_SUBMITTED @map("skipped_submitted")

  @@map("hostex_delivery_status")
}

enum HostexWebhookStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PROCESSED  @map("processed")
  FAILED     @map("failed")

  @@map("hostex_webhook_status")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]

  @@map("auth_user")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verification")
}

model Invite {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash          String                   @unique @map("token_hash")
  publicToken        String?                  @unique @map("public_token")
  checkIn            DateTime                 @map("check_in") @db.Date
  checkOut           DateTime                 @map("check_out") @db.Date
  purpose            String
  status             InviteStatus             @default(OPEN)
  expiresAt          DateTime                 @map("expires_at") @db.Timestamptz(3)
  submittedAt        DateTime?                @map("submitted_at") @db.Timestamptz(3)
  revokedAt          DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason      String?                  @map("revoked_reason")
  bookingId          String?                  @map("booking_id") @db.Uuid
  parentInviteId     String?                  @map("parent_invite_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  submission         Submission?
  booking            Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  parentInvite       Invite?                  @relation("InviteRegeneration", fields: [parentInviteId], references: [id], onDelete: SetNull)
  regeneratedInvites Invite[]                 @relation("InviteRegeneration")
  hostexAutomation   HostexBookingAutomation?
  hostexDeliveries   HostexMessageDelivery[]

  @@index([bookingId, createdAt])
  @@index([parentInviteId])
  @@map("invites")
}

model Booking {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationCode  String                   @map("reservation_code")
  stayCode         String                   @unique @map("stay_code")
  propertyId       Int                      @map("property_id")
  channelType      String                   @map("channel_type")
  channelId        String?                  @map("channel_id")
  listingId        String?                  @map("listing_id")
  status           String
  stayStatus       String?                  @map("stay_status")
  guestName        String?                  @map("guest_name")
  guestEmail       String?                  @map("guest_email")
  guestPhone       String?                  @map("guest_phone")
  numberOfGuests   Int?                     @map("number_of_guests")
  numberOfAdults   Int?                     @map("number_of_adults")
  numberOfChildren Int?                     @map("number_of_children")
  conversationId   String?                  @map("conversation_id")
  checkIn          DateTime                 @map("check_in") @db.Date
  checkOut         DateTime                 @map("check_out") @db.Date
  bookedAt         DateTime?                @map("booked_at") @db.Timestamptz(3)
  cancelledAt      DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  lastSyncedAt     DateTime                 @default(now()) @map("last_synced_at") @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  invites          Invite[]
  hostexAutomation HostexBookingAutomation?
  hostexDeliveries HostexMessageDelivery[]

  @@index([status, checkIn])
  @@index([guestEmail])
  @@index([reservationCode])
  @@map("bookings")
}

model HostexBookingAutomation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteId        String               @unique @map("invite_id") @db.Uuid
  bookingId       String               @unique @map("booking_id") @db.Uuid
  reservationCode String               @map("reservation_code")
  stayCode        String               @map("stay_code")
  propertyId      Int                  @map("property_id")
  channelType     String               @map("channel_type")
  conversationId  String?              @map("conversation_id")
  dueAt           DateTime             @map("due_at") @db.Timestamptz(3)
  status          HostexDeliveryStatus @default(SCHEDULED)
  attempts        Int                  @default(0)
  nextAttemptAt   DateTime?            @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt   DateTime?            @map("last_attempt_at") @db.Timestamptz(3)
  sentAt          DateTime?            @map("sent_at") @db.Timestamptz(3)
  confirmedAt     DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  requestId       String?              @map("request_id")
  lastError       String?              @map("last_error")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  invite          Invite               @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([conversationId])
  @@map("hostex_booking_automations")
}

model HostexMessageDelivery {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteId       String               @map("invite_id") @db.Uuid
  bookingId      String               @map("booking_id") @db.Uuid
  kind           HostexDeliveryKind
  conversationId String?              @map("conversation_id")
  status         HostexDeliveryStatus @default(SCHEDULED)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?            @map("next_attempt_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime?            @map("last_attempt_at") @db.Timestamptz(3)
  sentAt         DateTime?            @map("sent_at") @db.Timestamptz(3)
  confirmedAt    DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  requestId      String?              @map("request_id")
  lastError      String?              @map("last_error")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  invite         Invite               @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  booking        Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([inviteId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([conversationId])
  @@map("hostex_message_deliveries")
}

model HostexWebhookEvent {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey       String              @unique @map("dedupe_key")
  event           String
  reservationCode String?             @map("reservation_code")
  stayCode        String?             @map("stay_code")
  propertyId      Int?                @map("property_id")
  conversationId  String?             @map("conversation_id")
  messageId       String?             @map("message_id")
  eventTimestamp  DateTime            @map("event_timestamp") @db.Timestamptz(3)
  status          HostexWebhookStatus @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  lastError       String?             @map("last_error")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@map("hostex_webhook_events")
}

model HostexWebhookCredential {
  id           String   @id @default("primary")
  secretDigest String   @map("secret_digest")
  capturedAt   DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  @@map("hostex_webhook_credentials")
}

model Submission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteId     String           @unique @map("invite_id") @db.Uuid
  guestEmail   String           @map("guest_email")
  buildingCode String           @map("building_code")
  unitNumber   String           @map("unit_number")
  checkIn      DateTime         @map("check_in") @db.Date
  checkOut     DateTime         @map("check_out") @db.Date
  purpose      String
  ownerName    String           @map("owner_name")
  ownerContact String           @map("owner_contact")
  status       SubmissionStatus @default(READY_FOR_REVIEW)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  invite       Invite           @relation(fields: [inviteId], references: [id])
  guests       Guest[]
  runs         AutomationRun[]

  @@index([status, createdAt])
  @@map("submissions")
}

model Guest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String      @map("submission_id") @db.Uuid
  fullName     String      @map("full_name")
  age          Int
  requiresId   Boolean     @map("requires_id")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files        GuestFile[]

  @@index([submissionId])
  @@map("guests")
}

model GuestFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guestId     String   @map("guest_id") @db.Uuid
  storageKey  String   @unique @map("storage_key")
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  deleteAfter DateTime @map("delete_after") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([deleteAfter])
  @@map("guest_files")
}

model AutomationRun {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId         String     @map("submission_id") @db.Uuid
  status               String
  errorMessage         String?    @map("error_message")
  screenshotStorageKey String?    @map("screenshot_storage_key")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt           DateTime?  @map("finished_at") @db.Timestamptz(3)
  submission           Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([createdAt])
  @@map("automation_runs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model AdminAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("admin_audit_events")
}

model PricingSetting {
  id           String                  @id @default("primary")
  version      Int                     @default(1)
  automationOn Boolean                 @default(false) @map("automation_on")
  config       Json
  updatedBy    String?                 @map("updated_by")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  versions     PricingSettingVersion[]

  @@map("pricing_settings")
}

model PricingSettingVersion {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingId String         @map("setting_id")
  version   Int
  config    Json
  changedBy String?        @map("changed_by")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  setting   PricingSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, version])
  @@index([createdAt])
  @@map("pricing_setting_versions")
}

model PricingRun {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runKey          String?             @unique @map("run_key")
  mode            PricingRunMode
  status          PricingRunStatus    @default(RUNNING)
  settingsVersion Int                 @map("settings_version")
  configSnapshot  Json                @map("config_snapshot")
  occupancy       Json?
  initiatedBy     String?             @map("initiated_by")
  errorMessage    String?             @map("error_message")
  startedAt       DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?           @map("finished_at") @db.Timestamptz(3)
  days            PricingDay[]
  submissions     PricingSubmission[]

  @@index([startedAt])
  @@map("pricing_runs")
}

model PricingDay {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String     @map("run_id") @db.Uuid
  date           DateTime   @db.Date
  airbnbPrice    Int        @map("airbnb_price")
  available      Boolean
  occupancyRatio Float      @map("occupancy_ratio")
  event          String?
  reasons        Json
  run            PricingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, date])
  @@index([date])
  @@map("pricing_days")
}

model PricingSubmission {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String     @map("run_id") @db.Uuid
  channelType String     @map("channel_type")
  listingId   String     @map("listing_id")
  ratio       Float
  attempt     Int        @default(1)
  rangeCount  Int        @map("range_count")
  requestId   String?    @map("request_id")
  status      String
  error       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  run         PricingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, channelType, listingId, attempt])
  @@map("pricing_submissions")
}

model HostexCalendarDay {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelType  String   @map("channel_type")
  listingId    String   @map("listing_id")
  date         DateTime @db.Date
  price        Float?
  inventory    Int?
  restrictions Json?
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@unique([channelType, listingId, date])
  @@index([date])
  @@map("hostex_calendar_days")
}
