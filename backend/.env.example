# Local development uses DATABASE_URL. On AWS the database is Aurora with IAM authentication instead
# (DB_IAM_AUTH=true plus DB_HOST, DB_USER, DB_NAME); CDK sets those, so leave them blank here.
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=
PUBLIC_APP_URL=
PORT=

BUILDING_CODE=
UNIT_NUMBER=
OWNER_NAME=
OWNER_CONTACT=
MINOR_ID_CUTOFF=
GOOGLE_FORM_URL=
GOOGLE_ACCOUNT_EMAIL=mendozarhainne@gmail.com
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
EMAIL_REPLY_TO=
ENABLE_BACKGROUND_WORKERS=
# Local development only: run the @Cron schedules in-process. On AWS, SQS and EventBridge Scheduler do this.
RUN_INPROCESS_CRONS=true

# Browser Use Cloud Google-session recovery. Configure the 1Password service-account
# token only in Browser Use Cloud; this application receives IDs, never that token.
BROWSER_USE_API_KEY=
BROWSER_USE_1PASSWORD_INTEGRATION_ID=
BROWSER_USE_1PASSWORD_VAULT_ID=
BROWSER_USE_1PASSWORD_ITEM_ID=
BROWSER_USE_PROFILE_ID=

HOSTEX_ACCESS_TOKEN=
HOSTEX_PROPERTY_ID=12684960
HOSTEX_TIMEZONE=Asia/Manila
HOSTEX_WEBHOOK_SECRET=
HOSTEX_WEBHOOK_BOOTSTRAP_TOKEN=
ENABLE_HOSTEX_INVITE_AUTOMATION=false
ENABLE_HOSTEX_PRICING_AUTOMATION=false

# S3. On AWS only S3_BUCKET is needed (the function's IAM role supplies credentials; CDK sets it).
# Locally, point at any S3-compatible store: the bucket needs a CORS rule allowing http://localhost:5173.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_STYLE=

# Background jobs (set by CDK on AWS; leave blank locally so wake-ups run in-process)
JOBS_QUEUE_URL=
BROWSER_QUEUE_URL=

# AI ID review
OPENROUTER_API_KEY=
SENIOR_ID_CUTOFF=

# Used only by npm run migrate:legacy
SOURCE_DATABASE_URL=
# Use this after `npx wrangler login`, or provide the SOURCE_AWS_* values below.
SOURCE_R2_BUCKET_NAME=
SOURCE_AWS_ENDPOINT_URL=
SOURCE_AWS_DEFAULT_REGION=
SOURCE_AWS_S3_BUCKET_NAME=
SOURCE_AWS_ACCESS_KEY_ID=
SOURCE_AWS_SECRET_ACCESS_KEY=
SOURCE_AWS_S3_URL_STYLE=
